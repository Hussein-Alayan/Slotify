{
    "openapi": "3.0.0",
    "info": {
        "title": "Slotify API",
        "description": "API documentation for Slotify booking system",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/ai/process-message": {
            "post": {
                "tags": [
                    "AI Booking"
                ],
                "summary": "Process AI message and handle booking flow",
                "description": "Processes user messages through AI to extract booking intent, handle multi-step booking flow, and create bookings when all required information is collected. This endpoint is designed for n8n workflows and does not require authentication.",
                "operationId": "9e067d436aa2a7830d93de932ad4e205",
                "requestBody": {
                    "description": "Message processing request payload",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "conversation_id",
                                    "client_id",
                                    "message"
                                ],
                                "properties": {
                                    "conversation_id": {
                                        "description": "ID of the conversation this message belongs to",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "client_id": {
                                        "description": "ID of the client sending the message",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "message": {
                                        "description": "The user's message containing booking intent or information",
                                        "type": "string",
                                        "example": "I want to book a haircut for tomorrow at 3pm"
                                    },
                                    "force_booking_data": {
                                        "description": "Optional object to force specific booking data, bypassing AI analysis",
                                        "properties": {
                                            "service_id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "date": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2024-12-25"
                                            },
                                            "time": {
                                                "type": "string",
                                                "format": "time",
                                                "example": "15:00"
                                            }
                                        },
                                        "type": "object",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Message processed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message_processed": {
                                            "description": "Whether the message was successfully processed",
                                            "type": "boolean"
                                        },
                                        "flow_steps": {
                                            "description": "Steps taken during processing",
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "ai_analysis": {
                                            "description": "AI analysis results of the message",
                                            "type": "object"
                                        },
                                        "booking_created": {
                                            "description": "Whether a booking was created",
                                            "type": "boolean"
                                        },
                                        "booking": {
                                            "description": "Created booking details if booking was made",
                                            "type": "object",
                                            "nullable": true
                                        },
                                        "conversation_summary": {
                                            "description": "Summary of the conversation",
                                            "type": "object"
                                        },
                                        "processing_metadata": {
                                            "description": "Additional processing information",
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "description": "Error message",
                                            "type": "string"
                                        },
                                        "errors": {
                                            "description": "Validation errors",
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "description": "Error message",
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/register": {
            "post": {
                "tags": [
